<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FE">

    <LinearLayout
        android:id="@+id/headerAdminHotelEditor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="48dp"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">
        
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:padding="8dp"/>
            
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thêm Khách sạn"
            android:textColor="#2B3674"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerAdminHotelEditor"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/imgHotelPreview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_hotel"
                android:background="#E9EDF7"
                app:tint="#A3AED0"
                android:padding="48dp"/>

            <Button
                android:id="@+id/btnUploadImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn &amp; Upload Ảnh"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:backgroundTint="#4318FF"
                android:textColor="@color/white"/>

            <!-- Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên khách sạn *"
                android:textColor="#2B3674"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>
            <EditText
                android:id="@+id/edtHotelName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/white_bg"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:hint="Nhập tên khách sạn"/>

            <!-- Location -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vị trí *"
                android:textColor="#2B3674"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>
            <EditText
                android:id="@+id/edtHotelLocation"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/white_bg"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:hint="VD: Hà Nội, Đà Nẵng..."/>

            <!-- Price -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giá cơ bản/đêm (VNĐ) *"
                android:textColor="#2B3674"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>
            <EditText
                android:id="@+id/edtHotelPrice"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/white_bg"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:inputType="numberDecimal"
                android:hint="VD: 500000"/>

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mô tả"
                android:textColor="#2B3674"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>
            <EditText
                android:id="@+id/edtHotelDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/white_bg"
                android:padding="16dp"
                android:layout_marginTop="8dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:hint="Nhập mô tả về khách sạn..."/>

            <Button
                android:id="@+id/btnSaveHotel"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                android:text="LƯU KHÁCH SẠN"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="#05CD99"
                app:cornerRadius="12dp"/>
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>
