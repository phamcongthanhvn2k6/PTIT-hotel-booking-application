<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FE">

    <LinearLayout
        android:id="@+id/headerAdminRoomEditor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="48dp"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">
        
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#2B3674"
            android:padding="8dp"/>
            
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thêm Phòng"
            android:textColor="#2B3674"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerAdminRoomEditor"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Room Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Số phòng *"
                android:textColor="#2B3674"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>
            <EditText
                android:id="@+id/edtRoomNumber"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/white_bg"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:hint="VD: 101, 102..."/>

            <!-- Room Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loại phòng *"
                android:textColor="#2B3674"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>
            <EditText
                android:id="@+id/edtRoomType"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/white_bg"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:hint="VD: Standard, Deluxe..."/>

            <!-- Price -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giá mỗi đêm (VNĐ) *"
                android:textColor="#2B3674"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>
            <EditText
                android:id="@+id/edtRoomPrice"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/white_bg"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:inputType="numberDecimal"
                android:hint="VD: 500000"/>

            <!-- Status -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trạng thái *"
                android:textColor="#2B3674"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>
                
            <Spinner
                android:id="@+id/spinnerRoomStatus"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/white_bg"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="8dp"/>

            <Button
                android:id="@+id/btnSaveRoom"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                android:text="LƯU PHÒNG"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="#05CD99"
                app:cornerRadius="12dp"/>
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>
