<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/light_black_bg"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎉"
        android:textSize="56sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Đặt phòng thành công!"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Details Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#121222"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/dialogHotelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Khách sạn Mường Thanh"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialogLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="📍 Hà Nội"
            android:textColor="#B0B0B0"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A3E"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Checkin Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Ngày nhận:"
                android:textColor="#888888"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/dialogCheckInDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mon, 01/Jun"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Room Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Loại phòng:"
                android:textColor="#888888"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/dialogRoomType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standard"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Rooms Selected -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Phòng đặt:"
                android:textColor="#888888"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/dialogRoomsSelected"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Phòng 101, Phòng 102"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A3E"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Total Price -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Tổng số tiền:"
                android:textColor="#888888"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/dialogTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.000.000 ₫"
                android:textColor="#FF6B35"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Dismiss Button -->
    <TextView
        android:id="@+id/btnGoHome"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/orange_bg"
        android:gravity="center"
        android:text="Về trang chủ"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
